{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Masaifu",
  "version": "1.3.1",
  "identifier": "com.masaifu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "马赛福",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/funasr-sidecar/": "funasr-sidecar/",
      "resources/tts-sidecar/": "tts-sidecar/",
      "resources/pnote-sidecar/": "pnote-sidecar/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
